/*
 * secrets.h.example — TEMPLATE for sensitive credentials.
 *
 * SETUP:
 *   1. Copy this file to "secrets.h" (same folder).
 *   2. Fill in your real Wi-Fi credentials and Google Sheet ID.
 *   3. secrets.h is git-ignored and will never be committed.
 *
 * The Google service-account PRIVATE KEY is NOT stored here — it lives in
 * door_counter/data/service_account.json and is flashed to the device
 * filesystem separately (see README).
 */

#ifndef SECRETS_H
#define SECRETS_H

// --- Wi-Fi credentials ---
// Primary network (tried first). At its own location it connects instantly.
#define WIFI_SSID     "your_network_name"
#define WIFI_PASSWORD "your_network_password"

// Optional alternate networks (e.g. shop, second site). Define as many as you
// need; they're tried in order only if the earlier ones aren't in range.
// Delete or comment out the slots you don't use.
//#define WIFI_SSID_2     "shop_network_name"
//#define WIFI_PASSWORD_2 "shop_network_password"
//#define WIFI_SSID_3     "third_network_name"
//#define WIFI_PASSWORD_3 "third_network_password"

// --- Google Sheets ---
// The long ID from the sheet URL:
// https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
#define GSHEET_SHEET_ID "your_sheet_id_here"

#endif  // SECRETS_H
